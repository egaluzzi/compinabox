# Copy to .env and fill in. Placeholders only — never commit real values.
DATABASE_URL=postgres://complystart:changeme@localhost:5432/complystart
# Used by tests / verify.sh only: a throwaway Postgres (verify.sh creates a fresh database in it)
TEST_DATABASE_URL=
AUTH_SECRET=changeme
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ENABLED_COUNTRIES=br
RESEND_API_KEY=changeme
EMAIL_FROM=changeme
# Dev/CI only: write emails to .dev-outbox/ instead of sending. Never true in production.
EMAIL_DEV_SINK=false
# none (default: checkout unavailable) | fake | mercadopago (phase 9b)
PAYMENT_PROVIDER=none
# GUARDRAIL: fake payments provision accounts without payment. NEVER true on the droplet.
ALLOW_FAKE_PAYMENTS=false
FAKE_PAYMENTS_SECRET=
MERCADOPAGO_ACCESS_TOKEN=changeme
MERCADOPAGO_PUBLIC_KEY=changeme
MERCADOPAGO_WEBHOOK_SECRET=changeme
# Where logos are stored (default ./uploads; /opt/compinabox/uploads on the droplet)
UPLOADS_DIR=./uploads
# Whistleblower data at rest (SPEC §11): AES-256-GCM keys, comma-separated `id:base64(32 bytes)`. The
# FIRST key encrypts, all of them decrypt. Generate with: openssl rand -base64 32 — README "Report encryption key".
# No default and no fallback: unset or malformed = whistleblower pages/handlers fail loudly.
REPORT_ENCRYPTION_KEYS=k1:changeme-run-openssl-rand-base64-32
# Where encrypted evidence files live (default ./evidence; /opt/compinabox/evidence on the droplet).
# NEVER the uploads dir, never served by Caddy or the app's public routes.
EVIDENCE_DIR=./evidence
# Vendor sanctions screening (phase 7, README "Sanctions screening"). Unset or `changeme` = screening
# shows as "unavailable"; the questionnaire still works. Vendor NAMES (and an optional country code)
# are sent to this provider.
SCREENING_API_KEY=changeme
# Optional. Default https://api.opensanctions.org . Must be https (http only for localhost, for tests).
SCREENING_BASE_URL=
# Optional. Default `default` (OpenSanctions' catalogue of all datasets).
SCREENING_DATASET=
GTM_ID=changeme

# Backups (scripts/backup.sh) — see README "Backups"
# BACKUP_DEST=s3://your-space/complystart-backups   (or local:/path for testing)
# BACKUP_KEEP_DAYS=30
