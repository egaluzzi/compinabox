# Copy to .env and fill in. Placeholders only — never commit real values.
DATABASE_URL=postgres://complystart:changeme@localhost:5432/complystart
# Used by tests / verify.sh only: a throwaway Postgres (verify.sh creates a fresh database in it)
TEST_DATABASE_URL=
AUTH_SECRET=changeme
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
ENABLED_COUNTRIES=br
RESEND_API_KEY=changeme
EMAIL_FROM=changeme
# Dev/CI only: write emails to .dev-outbox/ instead of sending. Never true in production.
EMAIL_DEV_SINK=false
# none (default: checkout unavailable) | fake | mercadopago (phase 9b)
PAYMENT_PROVIDER=none
# GUARDRAIL: fake payments provision accounts without payment. NEVER true on the droplet.
ALLOW_FAKE_PAYMENTS=false
FAKE_PAYMENTS_SECRET=
MERCADOPAGO_ACCESS_TOKEN=changeme
MERCADOPAGO_PUBLIC_KEY=changeme
MERCADOPAGO_WEBHOOK_SECRET=changeme
# Where logos are stored (default ./uploads; /opt/compinabox/uploads on the droplet)
UPLOADS_DIR=./uploads
SCREENING_API_KEY=changeme
GTM_ID=changeme

# Backups (scripts/backup.sh) — see README "Backups"
# BACKUP_DEST=s3://your-space/complystart-backups   (or local:/path for testing)
# BACKUP_KEEP_DAYS=30
