[Unit]
Description=ComplyStart nightly Postgres backup
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# /opt/compinabox/.env holds DATABASE_URL and BACKUP_DEST (never committed)
EnvironmentFile=/opt/compinabox/.env
ExecStart=/opt/compinabox/scripts/backup.sh
# Run as the app's service user, which owns ~/.s3cfg for Spaces
User=complystart
Nice=10
